<script>
/* Pause the visual slideshow when the tab is hidden and respect reduced motion. */
(function(){
  try{
    const reduced=window.matchMedia && window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    const hero=document.querySelector('.sbm-store-hero');
    if(reduced && hero) hero.style.setProperty('--sbm-no-motion','1');
    document.addEventListener('visibilitychange',function(){
      if(!hero) return;
      hero.style.animationPlayState=document.hidden?'paused':'running';
    });
  }catch(e){}
})();
