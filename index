  function renderReviews(reviews){
    if(!grid) return;
    // Keep the approved featured reviews visible even when the backend has no approved reviews yet.
    if(!Array.isArray(reviews)) reviews = [];
    const seen = new Set(featuredReviews.map(r => String(r.name).trim().toLowerCase()));
    const extra = reviews.filter(r => { const k=String(r.name||'').trim().toLowerCase(); if(!k || seen.has(k)) return false; seen.add(k); return true; });
    reviews = featuredReviews.concat(extra);
    grid.innerHTML = reviews.slice(0,12).map(r => {
      const n = Math.max(1, Math.min(5, Number(r.rating)||5));
      return `<article class="public-review">
        <div class="public-stars">${'★'.repeat(n)}${'☆'.repeat(5-n)}</div>
