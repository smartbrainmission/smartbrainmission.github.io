  document.querySelectorAll('.scenario-btn').forEach((btn)=>{
    btn.addEventListener('click',()=>showScenario(Number(btn.dataset.index)));
  });

  function checkScenario(answer){
    const d=scenarioData[currentScenario];
    sf.textContent=answer===d.a?d.good:d.bad;
  }
  yesBtn.addEventListener('click',()=>checkScenario('yes'));
  noBtn.addEventListener('click',()=>checkScenario('no'));

