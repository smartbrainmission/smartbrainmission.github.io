    const name=document.getElementById('reviewName').value.trim();
    const type=document.getElementById('reviewType').value;
    const text=document.getElementById('reviewText').value.trim();

    if(!name || !text){ showStatus('Please enter your name and review.',false); return; }
    if(SBM_REVIEWS_ENDPOINT.includes('PASTE_YOUR_')){
      showStatus('Review system is not connected yet. Please use WhatsApp for now.',false);
      sendToWhatsApp(name,type,text);
      return;
    }

    // Google Apps Script receives this through a normal HTML form POST.
    // This avoids CORS issues on GitHub Pages.
    const iframeName='sbmReviewFrame';
    let iframe=document.getElementById(iframeName);
    if(!iframe){
      iframe=document.createElement('iframe');
      iframe.name=iframeName;
      iframe.id=iframeName;
      iframe.style.display='none';
      document.body.appendChild(iframe);
    }

    const post=document.createElement('form');
    post.method='POST';
    post.action=SBM_REVIEWS_ENDPOINT;
    post.target=iframeName;
    post.style.display='none';

    [['name',name],['type',type],['rating',rating],['review',text],['website','']].forEach(([k,v])=>{
      const input=document.createElement('input');
      input.name=k; input.value=v;
      post.appendChild(input);
    });

    document.body.appendChild(post);
    post.submit();
    post.remove();

    // Optimistic public display: the review appears immediately for the visitor.
    const existing = grid && grid.querySelector('.review-empty');
    if(existing) grid.innerHTML='';
    const card=document.createElement('article');
    card.className='public-review';
    card.innerHTML=`<div class="public-stars">${'★'.repeat(rating)}${'☆'.repeat(5-rating)}</div>
      <blockquote>“${escapeHTML(text)}”</blockquote>
      <div class="review-person"><div class="review-avatar">👤</div>
      <div><strong>${escapeHTML(name)}</strong><small>${escapeHTML(type)}</small></div></div>`;
    if(grid) grid.prepend(card);

    showStatus('Thank you! Your review has been shared with the Smart Brain Mission community. 💜');
    sendToWhatsApp(name,type,text);
    form.reset();
    rating=5; paint();
  });

  renderReviews(featuredReviews);
  loadPublicReviews();
})();
