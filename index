<script id="sbm-book-carousel-script">
(function(){
  const slides=[...document.querySelectorAll('.sbm-book-slide')];
  const dotsWrap=document.getElementById('sbmBookDots');
  const title=document.getElementById('sbmBookTitle');
  const desc=document.getElementById('sbmBookDesc');
  const eyebrow=document.getElementById('sbmBookEyebrow');
  const meta=document.getElementById('sbmBookMeta');
  const oldPrice=document.getElementById('sbmBookOld');
  const price=document.getElementById('sbmBookPrice');
  const cta=document.getElementById('sbmBookCTA');
  const sampleCta=document.getElementById('sbmBookSampleCTA');
  const counter=document.getElementById('sbmBookCounter');
  if(!slides.length) return;

  // Each rotating hero product gets its own free-sample PDF.
  const sampleMap = {
    book: 'assets/AI%20SAMPLE%20BOOK.pdf',
    parenting: 'assets/AI%20PARENTING%20GUIDE%20SAMPLE.pdf',
    activity: 'assets/AI%20ACTIVITY%20SAMPLE%20PACK.pdf',
    detective: 'assets/AI%20DETECTIVE%20SAMPLE%20PACK.pdf',
    coding: 'assets/AI%20CODING%20SAMPLE%20PACK.pdf',
    'think-ai': 'assets/THINK%20LIKE%20AI%20SAMPLE%20PACK.pdf',
    prompt: 'assets/AI%20PROMPT%20ENGINEERING%20SAMPLE%20BOOK.pdf'
  };
  let index=0,timer;
  slides.forEach((s,i)=>{const d=document.createElement('button');d.type='button';d.className='sbm-book-dot'+(i===0?' active':'');d.setAttribute('aria-label','Show '+(i+1));d.addEventListener('click',()=>{show(i);restart()});dotsWrap.appendChild(d)});
  const dots=[...dotsWrap.children];
  function show(n){
    index=(n+slides.length)%slides.length;
    slides.forEach((s,i)=>s.classList.toggle('active',i===index));
    dots.forEach((d,i)=>d.classList.toggle('active',i===index));
    const s=slides[index].dataset;
    eyebrow.textContent=s.eyebrow;
    title.textContent=s.title;
    desc.textContent=s.desc;
    meta.textContent=s.meta;
    oldPrice.textContent=s.old;
    price.textContent=s.price;
