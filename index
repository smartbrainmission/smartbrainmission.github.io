    if(!box){
      box=document.createElement('div');
      box.id='reviewStatus';
      box.style.cssText='margin-top:12px;padding:12px 15px;border-radius:14px;font-size:13px;font-weight:800;text-align:center;background:#f3eaff;color:#4d198c;';
