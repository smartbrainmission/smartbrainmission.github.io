  // Event delegation keeps dynamically-created answer buttons clickable on every question.
  if(quizOptions) quizOptions.addEventListener('click',function(e){
    const button=e.target.closest('.quiz-option');
    if(!button || quizLocked) return;
    const choice=Number(button.dataset.index);
    const d=quizData[quizIndex];
    quizLocked=true;

    quizOptions.querySelectorAll('.quiz-option').forEach((b,i)=>{
      b.disabled=true;
      if(i===d.correct) b.classList.add('quiz-correct');
      if(i===choice && i!==d.correct) b.classList.add('quiz-wrong');
