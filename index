<script id="sbm-final-age-filter-v2-js">
(function(){
  'use strict';
  var MAP={all:['age-5-8','age-8-12','age-13-16','for-parents'],age5:['age-5-8'],age8:['age-8-12'],age13:['age-13-16'],parents:['for-parents']};
  var booted=false;
  function boot(){
    if(booted) return; booted=true;
    var shop=document.getElementById('shop'); if(!shop) return;
    var head=shop.querySelector('.sbm-section-head'); if(!head) return;
    var ids=['age-5-8','age-8-12','age-13-16','for-parents'];
    var blocks={}; ids.forEach(function(id){var el=document.getElementById(id);if(el) blocks[id]=el;});
    var activity=document.getElementById('free-sample');
    var old=shop.querySelector('.sbm-clean-age-filter'); if(old) old.remove();
    var filter=document.createElement('div'); filter.className='sbm-clean-age-filter'; filter.setAttribute('role','tablist');
    [['all','All Products'],['age5','Ages 5–8'],['age8','Ages 8–12'],['age13','Ages 13–16'],['parents','For Parents']].forEach(function(d){
      var b=document.createElement('button'); b.type='button'; b.textContent=d[1]; b.dataset.filter=d[0]; b.setAttribute('role','tab'); filter.appendChild(b);
    });
    head.insertAdjacentElement('afterend',filter);

    /* Capture original product-card parents once. Moving the real cards preserves all existing cart/buy listeners. */
    var cards=[];
    ids.forEach(function(id){
      var grid=blocks[id] && blocks[id].querySelector('.sbm-category-products');
      if(!grid) return;
      Array.prototype.forEach.call(grid.querySelectorAll('.product-card'),function(card){cards.push({card:card,parent:grid});});
    });
    var allGrid=document.createElement('div'); allGrid.className='sbm-final-all-products-grid'; allGrid.setAttribute('aria-label','All Smart Brain Mission products');
    filter.insertAdjacentElement('afterend',allGrid);

    function restoreCards(){cards.forEach(function(x){if(x.parent && x.card.parentNode!==x.parent)x.parent.appendChild(x.card);});}
    function moveAllCards(){cards.forEach(function(x){allGrid.appendChild(x.card);});}
    function apply(key,scroll){
      var isAll=key==='all';
      if(isAll){
        restoreCards();
        /* restore first, then move into the one shared grid */
        moveAllCards();
        allGrid.style.display='grid';
      } else {
        allGrid.style.display='none';
        restoreCards();
      }
      ids.forEach(function(id){
        var el=blocks[id]; if(!el) return;
        var show=!isAll && MAP[key].indexOf(id)!==-1;
        el.classList.toggle('sbm-age-hidden',!show);
        el.classList.toggle('sbm-age-visible',show);
        el.classList.toggle('sbm-all-hidden',isAll);
        el.setAttribute('aria-hidden',show?'false':(isAll?'true':'true'));
      });
      if(activity) activity.style.display=(key==='all'||key==='age5')?'flex':'none';
      filter.querySelectorAll('button').forEach(function(btn){var active=btn.dataset.filter===key;btn.classList.toggle('active',active);btn.setAttribute('aria-selected',active?'true':'false');});
      if(scroll){var y=shop.getBoundingClientRect().top+window.pageYOffset-82;window.scrollTo({top:Math.max(0,y),behavior:'smooth'});}
    }
    filter.addEventListener('click',function(e){
      var btn=e.target.closest('button[data-filter]'); if(!btn)return;
      e.preventDefault();e.stopPropagation();e.stopImmediatePropagation();apply(btn.dataset.filter,true);
    });
    /* Make the Activity Packs CTA actually select Ages 5–8 and scroll to the products. */
    if(activity){var cta=activity.querySelector('a');if(cta){cta.addEventListener('click',function(e){e.preventDefault();e.stopImmediatePropagation();apply('age5',true);});}}
    /* Top category shortcuts */
    document.querySelectorAll('.sbm-category-card[href]').forEach(function(card){
      var href=card.getAttribute('href')||''; var key=href.indexOf('age-5-8')>-1?'age5':href.indexOf('age-8-12')>-1?'age8':href.indexOf('age-13-16')>-1?'age13':href.indexOf('for-parents')>-1?'parents':null;
      if(key) card.addEventListener('click',function(e){e.preventDefault();e.stopImmediatePropagation();apply(key,true);},true);
    });
    document.querySelectorAll('.sbm-store-links a').forEach(function(a){
      var t=(a.textContent||'').trim().toLowerCase();
      if(t==='for kids'){a.addEventListener('click',function(e){e.preventDefault();e.stopImmediatePropagation();apply('all',true);},true);}
    });
    apply('all',false);
  }
  if(document.readyState==='loading')document.addEventListener('DOMContentLoaded',boot);else boot();
})();
</script>





