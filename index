<script id="sbm-v11-hero-cta-fix">
(function(){
  function initHeroCtaFix(){
    const cta=document.getElementById('sbmBookCTA');
    if(!cta) return;
    function goToTarget(){
      const target=cta.getAttribute('href');
      if(!target || !target.startsWith('#')) return;
      const el=document.querySelector(target);
      if(!el) return;
      el.scrollIntoView({behavior:'smooth',block:'start'});
    }
    cta.addEventListener('click',function(e){
      const target=cta.getAttribute('href');
      if(target && target.startsWith('#')){
        e.preventDefault();
        goToTarget();
      }
    },true);
  }
  if(document.readyState==='loading') document.addEventListener('DOMContentLoaded',initHeroCtaFix);
  else initHeroCtaFix();
})();
</script>
