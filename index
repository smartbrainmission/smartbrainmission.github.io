      : '🔐 Secure download link valid for 15 minutes.';

    parent.appendChild(a);
    parent.appendChild(note);
  }

  function trackMetaEvent(eventName, params){
    try {
      if (typeof fbq === "function") {
        fbq("track", eventName, params || {});
      }
    } catch (e) {
      console.warn("Meta Pixel event failed:", eventName, e);
    }
  }

  function productParams(button){
    const productId = button && button.dataset ? button.dataset.sbmProductId : "";
    const product = button && button.dataset ? (button.dataset.sbmProduct || "Smart Brain Mission") : "Smart Brain Mission";
    const price = button && button.dataset ? Number(button.dataset.sbmPrice || 0) : 0;
    return {
      content_name: product,
      content_ids: productId ? [productId] : [],
      content_type: "product",
      value: price,
      currency: "INR"
    };
  }

  // Meta: ViewContent when a product card becomes visible on screen.
  function setupMetaViewContent(){
    if (typeof IntersectionObserver === "undefined") return;
    const cards = document.querySelectorAll(".product-card, .ai-book-card");
    const seen = new WeakSet();
    const observer = new IntersectionObserver(function(entries){
      entries.forEach(function(entry){
        if (!entry.isIntersecting || seen.has(entry.target)) return;
        const button = entry.target.querySelector(".sbm-razorpay-test-btn");
        if (!button) return;
        seen.add(entry.target);
        trackMetaEvent("ViewContent", productParams(button));
        observer.unobserve(entry.target);
      });
    }, {threshold: 0.35});
    cards.forEach(function(card){ observer.observe(card); });
  }

  setupMetaViewContent();

