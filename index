<script id="sbm-parent-nav-fix-script">
(function(){
  function goParents(e){
    e.preventDefault();
    e.stopPropagation();
    var el = document.getElementById("for-parents");
    if(el){
      el.scrollIntoView({behavior:"smooth", block:"start"});
      try{ history.replaceState(null,"","#for-parents"); }catch(_){}
    }
  }
  document.addEventListener("click", function(e){
    var a = e.target && e.target.closest ? e.target.closest('a[href="#for-parents"]') : null;
    if(a) goParents(e);
  }, true);
})();
</script>


