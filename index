    counter.textContent=String(index+1);
  }
  function restart(){clearInterval(timer);timer=setInterval(()=>show(index+1),4500)}
  document.querySelector('.sbm-book-next')?.addEventListener('click',()=>{show(index+1);restart()});
  document.querySelector('.sbm-book-prev')?.addEventListener('click',()=>{show(index-1);restart()});
