          <div class="review-avatar">👤</div>
          <div><strong>${escapeHTML(r.name)}</strong><small>${escapeHTML(r.type)}</small></div>
        </div>
      </article>`;
    }).join('');
  }

  // Load public reviews through JSONP so GitHub Pages does not need CORS.
  function loadPublicReviews(){
    if(SBM_REVIEWS_ENDPOINT.includes('PASTE_YOUR_')) return;
    const callback = 'SBMReviews_' + Date.now();
    window[callback] = function(data){
      try { renderReviews(typeof data === 'string' ? JSON.parse(data) : data); }
      catch(e) {}
      delete window[callback];
      script.remove();
    };
    const script=document.createElement('script');
    script.src=SBM_REVIEWS_ENDPOINT + '?action=list&callback=' + callback + '&_=' + Date.now();
    script.onerror=()=>{ script.remove(); };
    document.body.appendChild(script);
  }

  function sendToWhatsApp(name,type,text){
